# ---------------------------------------------------------------------------
# XTransMatrix AI Operator Certification Platform — environment configuration
# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in. All VITE_* vars are PUBLIC (bundled into the
# client). Never place a private/secret API key in this file.

# --- Supabase (production-ready persistence) -------------------------------
# The anon key is designed to be public and MUST be paired with Row Level
# Security policies. See supabase/schema.sql for the full schema + RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# When empty/absent, the app transparently falls back to the LocalStorage
# persistence adapter so the platform is fully functional offline.

# --- Text-to-speech ---------------------------------------------------------
# Which TTS provider to use: "browser" | "openai" | "elevenlabs"
# "browser" uses the Web Speech API and needs no keys.
VITE_TTS_PROVIDER=browser

# OpenAI / ElevenLabs keys must NEVER be exposed to the browser. Instead run the
# documented edge function / server proxy and point the app at it:
VITE_TTS_PROXY_URL=
